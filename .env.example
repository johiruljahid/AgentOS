# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: OAuth 2.0 Web Client ID
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# GOOGLE_CLIENT_SECRET: OAuth 2.0 Client Secret (Server-side Secret Manager only)
GOOGLE_CLIENT_SECRET="your-client-secret"

# FIREBASE_PROJECT_ID: Cloud Firestore & Firebase Auth project ID
FIREBASE_PROJECT_ID="gen-lang-client-0940395063"

# FIREBASE_CLIENT_EMAIL: Firebase Admin Service Account email
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@gen-lang-client-0940395063.iam.gserviceaccount.com"

# FIREBASE_PRIVATE_KEY: Firebase Admin Service Account private key
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# GOOGLE_CLOUD_PROJECT: Host project identifier
GOOGLE_CLOUD_PROJECT="gen-lang-client-0940395063"

# CLOUD_TASKS_QUEUE: Queue name for asynchronous background tasks
CLOUD_TASKS_QUEUE="projects/gen-lang-client-0940395063/locations/asia-east1/queues/agentos-tasks"

# SECRET_MANAGER_REF: Reference path for Secret Manager
SECRET_MANAGER_REF="projects/741966588549/secrets/agentos-oauth-credentials"

# BROWSERBASE_API_KEY: Browserbase Cloud Browser Automation API Key (Backend-only, never exposed to client)
BROWSERBASE_API_KEY="your-browserbase-api-key"

# BROWSERBASE_PROJECT_ID: Browserbase Project ID
BROWSERBASE_PROJECT_ID="your-browserbase-project-id"

# BROWSER_AUTOMATION_ENDPOINT: Fallback local headless runner if needed
BROWSER_AUTOMATION_ENDPOINT="http://localhost:9222"
